<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Imora</string>
	<key>IMORAAppGroup</key>
	<string>$(IMORA_APP_GROUP)</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Imora backs up your photo library to your Immich server and removes device copies only when you ask it to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Imora shows where you are on the photo map. Your location never leaves the device.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Imora connects to your Immich server, which is often a machine on your own network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).backup</string>
	</array>
</dict>
</plist>
